# Copy to .env.local for development. Set the same keys in Netlify (Site configuration → Environment variables).
# Values come from https://www.sanity.io/manage → your project → Project ID and dataset name.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Editor token for one-off migrations (scripts/migrate-locale-fields.mjs).
# Create at https://www.sanity.io/manage → API → Tokens (Editor permissions).
SANITY_API_WRITE_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys). Use test keys (sk_test_…) locally.
STRIPE_SECRET_KEY=

# Public URL used for Stripe success/cancel redirects. In production set this to
# the deployed site URL (e.g. https://comtebureau.com); leave empty in dev to
# default to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
