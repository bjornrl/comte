# Copy to .env.local for development. Set the same keys in Netlify (Site configuration → Environment variables).
# Values come from https://www.sanity.io/manage → your project → Project ID and dataset name.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Editor token (Editor permissions). Used by one-off migrations
# (scripts/migrate-locale-fields.mjs) AND by the Stripe webhook to write
# `purchase` records. REQUIRED for paid checkout fulfillment to be recorded.
# Create at https://www.sanity.io/manage → API → Tokens.
SANITY_API_WRITE_TOKEN=

# Stripe secret key (https://dashboard.stripe.com/apikeys).
# Use test keys (sk_test_…) locally; live keys (sk_live_…) in production.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_…). Verifies that webhook events at
# /api/stripe/webhook genuinely came from Stripe.
#   - Production: Dashboard → Developers → Webhooks → add endpoint
#     https://<your-site>/api/stripe/webhook (event: checkout.session.completed),
#     then copy its "Signing secret".
#   - Local testing: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#     and use the whsec_… it prints.
STRIPE_WEBHOOK_SECRET=

# Public URL used for Stripe success/cancel redirects. In production set this to
# the deployed site URL (e.g. https://comtebureau.com); leave empty in dev to
# default to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
